{
  "manifest_version": 3,
  "name": "Genuinely Goated Lean Pips Solver",
  "version": "0.1.0",
  "description": "Ideally this should win us the hackathon right?",
  "permissions": ["activeTab", "sidePanel", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://www.nytimes.com/games/pips*",
    "https://www.nytimes.com/puzzles/pips*"
  ],
  "action": {
    "default_title": "Pippertons",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["pips_puzzles.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/pips*",
        "https://www.nytimes.com/puzzles/pips*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
